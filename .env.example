# ============================================================
# .env.example - Template konfigurasi environment
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# --- Konfigurasi Database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password_anda
DB_NAME=agregasi_pengumuman

# --- Konfigurasi Discord Webhook (Multi-Channel) ---
# Dapatkan URL webhook dari: Server Settings > Integrations > Webhooks
# Buat webhook terpisah untuk setiap channel (baak, lepkom, studentsite, kemahasiswaan, pendaftaran-mhs-baru)
# Kosongkan webhook yang belum siap (notifikasi akan di-skip untuk sumber itu)
DISCORD_WEBHOOK_BAAK=
DISCORD_WEBHOOK_LEPKOM=
DISCORD_WEBHOOK_STUDENTSITE=
DISCORD_WEBHOOK_KEMAHASISWAAN=
DISCORD_WEBHOOK_PENDAFTARAN=

# Kirim notifikasi Discord saat initial scraping (true/false)
# true: Kirim notifikasi untuk data INSERT baru dari initial scraping
# false: Tidak kirim notifikasi saat initial scraping (hanya simpan baseline)
SEND_DISCORD_ON_INITIAL=false

# Jeda antar pengiriman notifikasi Discord (dalam detik)
# Untuk menghindari rate limit Discord
DISCORD_SEND_DELAY_SECONDS=3

# Jeda untuk mengirim data lama yang belum pernah dikirim (dalam menit)
# Untuk mode testing/backlog
DISCORD_OLD_BATCH_DELAY_MINUTES=5

# --- Konfigurasi Monitoring ---
# Interval monitoring dalam menit (default: 60)
MONITORING_INTERVAL_MINUTES=60

# --- Konfigurasi Scraping ---
# Jumlah pengumuman yang diambil saat initial scraping per website
INITIAL_SCRAPE_LIMIT=5

# --- Mode Debug (opsional) ---
# Set ke "true" untuk menampilkan log debug di console
DEBUG_MODE=false
