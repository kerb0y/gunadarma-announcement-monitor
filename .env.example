# ============================================================
# .env.example - Template konfigurasi environment
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# --- Konfigurasi Database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password_anda
DB_NAME=agregasi_pengumuman

# --- Konfigurasi Discord Webhook ---
# Dapatkan URL webhook dari: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/XXXXXXXXXXXXXXXXXXXX

# --- Konfigurasi Monitoring ---
# Interval monitoring dalam menit (default: 60)
MONITORING_INTERVAL_MINUTES=60

# --- Konfigurasi Scraping ---
# Jumlah pengumuman yang diambil saat initial scraping per website
INITIAL_SCRAPE_LIMIT=5

# --- Mode Debug (opsional) ---
# Set ke "true" untuk menampilkan log debug di console
DEBUG_MODE=false
